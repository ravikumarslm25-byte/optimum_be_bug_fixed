# ============================================================================
#  Optimum Health CRM — Backend environment (.env)
#  Copy this to the backend root as ".env" on the new server and fill in values.
#  (The uploaded backend zip had no .env — these are the variables app.js reads.)
# ============================================================================

# Port the Node app listens on. nginx proxies api.optimumhealth.in -> this port.
# MUST match the proxy_pass port in deploy/nginx/api.optimumhealth.in.conf
PORT=5001

# production mode
NODE_ENV=production

# MongoDB connection string (Atlas or self-hosted)
MONGO_URI=

# JWT signing secret (keep the SAME value you used on the old server, otherwise
# all currently logged-in users are logged out)
JWT_SECRET=

# AWS S3 — used for document/file uploads (reuse the old server's values)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
AWS_S3_BUCKET=
